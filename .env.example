# =============================================================================
# COMPATIBILITY CHAOS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive API keys!
# =============================================================================

# -----------------------------------------------------------------------------
# RESEND EMAIL SERVICE
# -----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email "From" address - must be verified in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Friendly name for email sender
RESEND_FROM_NAME=Compatibility Chaos

# -----------------------------------------------------------------------------
# SUPABASE DATABASE
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
# Note: These are safe to expose client-side (SUPABASE_ANON_KEY has RLS)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# LLM / AI CONFIGURATION
# -----------------------------------------------------------------------------
# Provider: 'openai' | 'anthropic' | 'gemini'
LLM_PROVIDER=gemini

# API Keys (get from respective providers):
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - Google Gemini: https://aistudio.google.com/app/apikey

# For OpenAI:
# OPENAI_API_KEY=sk-...

# For Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# For Google Gemini:
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# LLM MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# Model to use (depends on provider):
# - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# - Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# - Gemini: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash, gemini-pro

LLM_MODEL=gemini-2.5-flash

# Temperature (0-1): Lower = more focused, Higher = more creative
# Recommended: 0.7 for personality insights
LLM_TEMPERATURE=0.7

# Max tokens for response (optional)
# LLM_MAX_TOKENS=1000

# Custom endpoint (optional - for self-hosted models)
# LLM_ENDPOINT=https://your-custom-endpoint.com/v1

# -----------------------------------------------------------------------------
# OPTIONAL: RATE LIMITING & SECURITY
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limit per IP (requests per hour)
# RATE_LIMIT_PER_HOUR=100
